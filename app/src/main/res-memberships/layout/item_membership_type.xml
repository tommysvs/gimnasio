<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre de membresía"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gym_bg_deep" />

            <TextView
                android:id="@+id/tvMemDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descripción de la membresía"
                android:textColor="@color/gym_silver"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvMemDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="30 días"
                android:textColor="@color/gym_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="L 0.00"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary" />

            <ImageButton
                android:id="@+id/btnEditMem"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_edit"
                app:tint="@color/gym_silver"
                android:contentDescription="Editar" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>